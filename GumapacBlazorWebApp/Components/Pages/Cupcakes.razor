@page "/Cupcakes"
@rendermode InteractiveServer
<PageTitle>CUPCAKES MENU</PageTitle>

<div class="bg-cupcake"></div>

<div class="cupcake-menu">
    <div class="menu-header">
        <h1>🧁 CUPCAKES MENU 🧁</h1>
        <p>One bite and you're in cupcake heaven!</p>
    </div>

    <!-- 1. STRAWBERRY -->
    <div class="menu-item item-straw">
        <div class="img-box">
            <img src="images/strawberrycup.jpg" alt="straw" />
        </div>
        <div class="item-details">
            <div class="item-top">
                <h3>STRAWBERRY CUPCAKE</h3>
                <span class="price">₱49.00</span>
            </div>
            <p>Soft moist cake made with real strawberries, topped with rich strawberry buttercream frosting.</p>
            <div class="item-bottom">
                <span class="badge">Best seller</span>
            </div>
        </div>
    </div>

    <!-- 2. COOKIES AND CREAM -->
    <div class="menu-item item-cookies">
        <div class="img-box">
            <img src="images/cookiescup.jpg" alt="cookies" />
        </div>
        <div class="item-details">
            <div class="item-top">
                <h3>COOKIES AND CREAM CUPCAKE</h3>
                <span class="price">₱49.00</span>
            </div>
            <p>Moist vanilla cake loaded with Oreo chunks, topped with cookies and cream buttercream and extra cookie crumble.</p>
            <div class="item-bottom">
                <span class="badge">Pinoy Favorite</span>
            </div>
        </div>
    </div>

    <!-- 3. BANANA -->
    <div class="menu-item item-banana">
        <div class="img-box">
            <img src="images/bananacup.jpg" alt="banana" />
        </div>
        <div class="item-details">
            <div class="item-top">
                <h3>BANANA CUPCAKE</h3>
                <span class="price">₱39.00</span>
            </div>
            <p>Incredibly soft and fluffy, flavored heavily with fresh ripe bananas. With a touch of cinnamon and vanilla.</p>
            <div class="item-bottom">
                <span class="badge">Summer special</span>
            </div>
        </div>
    </div>

    <!-- 4. UBE -->
    <div class="menu-item item-ube">
        <div class="img-box">
            <img src="images/ubecup.jpg" alt="ube" />
        </div>
        <div class="item-details">
            <div class="item-top">
                <h3>UBE CUPCAKE</h3>
                <span class="price">₱39.00</span>
            </div>
            <p>Made with real purple yam for genuine taste. Melt-in-your-mouth crumb with creamy ube frosting.</p>
            <div class="item-bottom">
                <span class="badge">Classic</span>
            </div>
        </div>
    </div>

    <!-- 5. YEMA -->
    <div class="menu-item item-yema">
        <div class="img-box">
            <img src="images/yemacup.jpg" alt="yema" />
        </div>
        <div class="item-details">
            <div class="item-top">
                <h3>YEMA CUPCAKE</h3>
                <span class="price">₱39.00</span>
            </div>
            <p>Vanilla cupcake filled with creamy yema custard and topped with yema drizzle and toasted nuts.</p>
            <div class="item-bottom">
                <span class="badge">My Greatest Love</span>
            </div>
        </div>
    </div>
</div>

<style>
    /* BACKGROUND IMAGE */
    .bg-cupcake {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('images/cupcake.jpg'); /* PUT YOUR PHOTO HERE */
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
        filter: brightness(0.6) blur(2px);
        z-index: -2;
    }

        .bg-cupcake::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(255, 193, 227, 0.85) 0%, rgba(179, 229, 252, 0.85) 100%); /* pink to blue overlay */
            z-index: -1;
        }

    .cupcake-menu {
        max-width: 1000px;
        margin: 40px auto;
        padding: 20px;
        position: relative;
        z-index: 1;
    }

    /* HEADER */
    .menu-header {
        text-align: center;
        margin-bottom: 50px;
        padding: 40px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 25px;
        border: 5px dotted #ffb6c1;
        box-shadow: 0 8px 20px rgba(255, 193, 227, 0.4);
    }

        .menu-header h1 {
            color: #ad1457;
            font-size: 3rem;
            margin: 0;
            text-shadow: 2px 2px 0 white;
        }

        .menu-header p {
            color: #4a148c;
            font-size: 1.2rem;
            font-weight: 600;
            margin-top: 10px;
        }

    /* MENU ITEM */
    .menu-item {
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
        align-items: flex-start;
        margin-bottom: 30px;
        padding: 25px;
        border-radius: 20px;
        background-color: rgba(255, 255, 255, 0.97);
        box-shadow: 0 6px 18px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        border-bottom: 6px solid;
    }

        .menu-item:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        }

    /* IMAGE BOX */
    .img-box {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        overflow: hidden;
        border: 5px solid;
        flex-shrink: 0;
    }

        .img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .menu-item:hover .img-box img {
        transform: scale(1.1) rotate(3deg);
    }

    /* DETAILS */
    .item-details {
        flex: 1;
        min-width: 250px;
        display: flex;
        flex-direction: column;
    }

    .item-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 10px;
    }

    .item-details h3 {
        margin: 0;
        font-size: 1.6rem;
        flex: 1;
    }

    .item-details p {
        color: #555;
        line-height: 1.7;
        margin: 0 0 15px 0;
        flex-grow: 1;
    }

    .item-bottom {
        display: flex;
        justify-content: flex-start;
    }

    /* PRICE AND BADGE */
    .price {
        font-size: 1.6rem;
        font-weight: 900;
        padding: 6px 16px;
        border-radius: 15px;
        white-space: nowrap;
    }

    .badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 700;
    }

    /* COLOR THEME PER CUPCAKE */
    .item-banana {
        border-bottom-color: #ffb74d;
    }

        .item-banana h3 {
            color: #e65100;
        }

        .item-banana .img-box {
            border-color: #ffb74d;
        }

        .item-banana .badge {
            background-color: #fff3e0;
            color: #e65100;
        }

        .item-banana .price {
            background-color: #fff3e0;
            color: #e65100;
        }

    .item-cookies {
        border-bottom-color: #90a4ae;
    }

        .item-cookies h3 {
            color: #455a64;
        }

        .item-cookies .img-box {
            border-color: #90a4ae;
        }

        .item-cookies .badge {
            background-color: #eceff1;
            color: #455a64;
        }

        .item-cookies .price {
            background-color: #eceff1;
            color: #455a64;
        }

    .item-straw {
        border-bottom-color: #f06292;
    }

        .item-straw h3 {
            color: #c2185b;
        }

        .item-straw .img-box {
            border-color: #f06292;
        }

        .item-straw .badge {
            background-color: #fce4ec;
            color: #c2185b;
        }

        .item-straw .price {
            background-color: #fce4ec;
            color: #c2185b;
        }

    .item-ube {
        border-bottom-color: #ba68c8;
    }

        .item-ube h3 {
            color: #8e24aa;
        }

        .item-ube .img-box {
            border-color: #ba68c8;
        }

        .item-ube .badge {
            background-color: #f3e5f5;
            color: #8e24aa;
        }

        .item-ube .price {
            background-color: #f3e5f5;
            color: #8e24aa;
        }

    .item-yema {
        border-bottom-color: #ffd54f;
    }

        .item-yema h3 {
            color: #f9a825;
        }

        .item-yema .img-box {
            border-color: #ffd54f;
        }

        .item-yema .badge {
            background-color: #fffde7;
            color: #f9a825;
        }

        .item-yema .price {
            background-color: #fffde7;
            color: #f9a825;
        }
</style>