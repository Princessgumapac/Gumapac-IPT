@page "/"
@using System.Net.Http.Json
@using GUMAPAC_project.Components.Models
@inject HttpClient Http
@inject NavigationManager Nav

<h1>Hello, world!</h1>
Welcome to your new app.
<h1>Yan's Profile</h1>

@if (meModels == null)
{
    <h1>YAWAAAA</h1>
}
else
{
    <h2>@meModels.fullname</h2>
    <h2>@meModels.id</h2>
    <h2>@meModels.course</h2>
}

@code {
    private Me? meModels;

    protected override async Task OnInitializedAsync()
    {
        string url = "https://localhost:7162/api/Me";
        meModels = await Http.GetFromJsonAsync<Me>(url);
    }
}